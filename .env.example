# Copy to .env and fill in. `docker compose up` fails fast if the required ones are unset.

# PostgreSQL password for the `gitsrv` role. Required.
DB_PASSWORD=change-me-local-dev

# JWT signing key. Required. Must be >= 32 characters and random outside Development.
JWT_SIGNING_KEY=dev-only-signing-key-change-me-please-32chars-min

# Host port the web tier is published on. Default 8080.
WEB_PORT=8080

# Host port the SSH git transport is published on. Default 2222.
SSH_PORT=2222

# Public base URL, used when generating clone URLs and links. Default http://localhost:8080.
PUBLIC_BASE_URL=http://localhost:8080

# Production | Development. Default Production.
ASPNETCORE_ENVIRONMENT=Production
