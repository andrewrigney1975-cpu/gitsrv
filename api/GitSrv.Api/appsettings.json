{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "SigningKey": ""
  },
  "GitSrv": {
    "RepositoryRoot": "/var/lib/gitsrv/repositories",
    "RunMigrationsOnStartup": true
  },
  "App": {
    "PublicBaseUrl": "http://localhost:8080"
  }
}
